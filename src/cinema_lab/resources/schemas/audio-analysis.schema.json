{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MindMobius/audio-to-cinema-lab/schemas/audio-analysis.schema.json",
  "$defs": {
    "audioSource": {
      "type": "object",
      "required": ["role", "source_policy"],
      "properties": {
        "role": {"enum": ["music", "song", "speech", "voiceover", "soundscape", "unknown"]},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "sample_rate": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1},
        "source_policy": {"enum": ["private-local", "public-license", "generated", "external-reference"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "required": ["duration_seconds", "analysis_status"],
  "properties": {
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "analysis_status": {"enum": ["observed", "reviewed", "partial", "planned"]},
    "estimated_bpm": {"type": "number", "exclusiveMinimum": 0},
    "beat_offset_seconds": {"type": "number", "minimum": 0},
    "observations": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
