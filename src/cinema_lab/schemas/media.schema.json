{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MindMobius/audio-to-cinema-lab/schemas/media.schema.json",
  "title": "Project Media Manifest",
  "type": "object",
  "required": ["version", "files"],
  "properties": {
    "version": {"const": 1},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "path", "bytes", "sha256", "profiles"],
        "properties": {
          "id": {"type": "string"},
          "source": {"type": "string"},
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "profiles": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    },
    "public_files": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
